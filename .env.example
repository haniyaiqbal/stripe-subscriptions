NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://billing:billing@localhost:5433/billing
# At least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-secret-0123456789
APP_URL=http://localhost:3000
# Stripe dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen` (local) or shown on your webhook endpoint (deployed)
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# These emails become admins when they sign up
ADMIN_EMAILS=admin@example.com
